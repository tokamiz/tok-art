# Vorlage für die Konfiguration auf dem Server (STRATO).
#
# `make release` legt daraus beim ersten Mal deploy/.env.local mit einem zufälligen APP_SECRET an
# und verwendet sie bei jedem weiteren Release wieder. deploy/.env.local steht nicht in Git.
#
# Im Release-Ordner wird daraus .env.local.php (schneller, Symfony liest dann keine .env-Dateien mehr).

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=__WIRD_AUTOMATISCH_ERZEUGT__

# Datenbank bei STRATO: Werte aus dem Kundenlogin (Datenbanken → Zugangsdaten) in deploy/.env.local eintragen.
#   BENUTZER, PASSWORT, HOST, DATENBANK ersetzen. Sonderzeichen im Passwort URL-kodieren (z. B. @ → %40).
#   serverVersion an die angezeigte Version anpassen, z. B. 10.11.0-MariaDB oder 8.0.36 bei MySQL.
DATABASE_URL="mysql://BENUTZER:PASSWORT@HOST:3306/DATENBANK?serverVersion=10.11.0-MariaDB&charset=utf8mb4"
