  {
    "id": "am-wasserfall",
    "title": "Am Wasserfall",
    "date": "2024",
    "tripId": "island",
    "topicIds": [
      "berge",
      "meer"
    ],
    "blocks": [
      {
        "id": "b1",
        "type": "text",
        "content": "Den Skógafoss hört man, lange bevor man ihn sieht. Rund 60 Meter stürzt das Wasser über die alte Küstenklippe, und je näher man kommt, desto feiner legt sich die Gischt auf Gesicht und Jacke."
      },
      {
        "id": "b2",
        "type": "video",
        "mediaId": "skogafoss",
        "caption": "Direkt vor dem Skógafoss"
      },
      {
        "id": "b3",
        "type": "text",
        "content": "Neben dem Wasserfall führt eine lange Treppe nach oben. Von dort geht der Blick über die flache Ebene bis zum Meer, das hier einmal bis an die Felsen reichte."
      }
    ]
  }
