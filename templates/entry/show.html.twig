{% extends 'base.html.twig' %}

{% block title %}{{ entry.title }}{% endblock %}

{% block body %}
    <article class="stack stack--loose">
        <header>
            <h1 class="page-title">{{ entry.title }}</h1>
            {% if entry.date %}
                <p class="card__meta">{{ entry.date|date_de }}</p>
            {% endif %}
        </header>

        {# Jeder Blocktyp hat eine eigene Vorlage in templates/blocks/. Die Seite schlägt die Medien nach. #}
        {% for block in entry.blocks %}
            {{ include('blocks/_' ~ block.type ~ '.html.twig', {block: block, media: media}) }}
        {% endfor %}
    </article>
{% endblock %}
